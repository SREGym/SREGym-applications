#!/usr/bin/env python3
"""Company on-call CLI. Guest commands run only on company servers."""

import json
import shutil
import sys
import urllib.error
import urllib.parse
import urllib.request
import uuid

BASE = "http://127.0.0.1:28311"


def request(path, data=None, raw=False):
    r = urllib.request.urlopen(
        urllib.request.Request(
            BASE + path,
            data=None if data is None else json.dumps(data).encode(),
            headers={"Content-Type": "application/json", "X-Client": "oncall"},
        ),
        timeout=1900,
    )
    if raw:
        with r:
            shutil.copyfileobj(r, sys.stdout.buffer, 65536)
        return
    with r:
        body = r.read()
        return json.loads(body) if body else {"accepted": r.status}


try:
    op = sys.argv[1]
    if op == "template":
        print(
            json.dumps(
                request(
                    "/provider/v2.1/templates/default",
                    json.load(open(sys.argv[2])) if len(sys.argv) > 2 else None,  # noqa: SIM115
                ),
                indent=2,
            )
        )
    elif op == "create":
        print(json.dumps(request("/provider/v2.1/instances", dict(name=sys.argv[2]))))
    elif op == "delete":
        print(json.dumps(request("/provider/v2.1/instances/" + urllib.parse.quote(sys.argv[2]) + "/delete", {})))
    elif op == "inventory":
        print(json.dumps(request("/provider/v2.1/servers/detail"), indent=2))
    elif op == "stream":
        transfer = uuid.uuid4().hex
        request(
            "/stream",
            dict(server=sys.argv[2], command=" ".join(sys.argv[3:]), timeout=1800, transfer_id=transfer),
            True,
        )
        result = request("/stream-status/" + transfer)
        if result.get("state") != "complete":
            raise ValueError("Stream did not complete")
        if result.get("error"):
            print(result["error"], file=sys.stderr)
        sys.exit(result["exit_code"])
    elif op in ["exec", "console"]:
        result = request("/" + op, dict(server=sys.argv[2], command=" ".join(sys.argv[3:]), timeout=1800))
        print(result.get("stdout", ""), end="")
        print(result.get("stderr", ""), end="", file=sys.stderr)
        sys.exit(result.get("exit_code", 0))
    elif op in ["stop", "start", "rescue", "unrescue", "unrescue-stopped", "rebuild"]:
        action = {"stop": "os-stop", "start": "os-start", "unrescue-stopped": "unrescue"}.get(op, op)
        print(
            json.dumps(
                request(
                    "/provider/v2.1/servers/" + urllib.parse.quote(sys.argv[2]) + "/action",
                    {action: ({"start": False} if op == "unrescue-stopped" else None)},
                )
            )
        )
    elif op == "put":
        import os

        path = "/upload?" + urllib.parse.urlencode(dict(server=sys.argv[2], path=sys.argv[4]))
        with open(sys.argv[3], "rb") as data:
            r = urllib.request.urlopen(
                urllib.request.Request(
                    BASE + path, data=data, headers={"Content-Length": str(os.fstat(data.fileno()).st_size)}
                ),
                timeout=1900,
            )
            result = json.loads(r.read())
            print(json.dumps(result))
            sys.exit(result.get("exit_code", 0))
    else:
        raise ValueError(
            "Usage: companyctl inventory | exec/console/stream SERVER COMMAND | put SERVER LOCAL GUEST_PATH"
            " | start/stop/rescue/unrescue/unrescue-stopped/rebuild SERVER | template [JSON_FILE] | create/delete NAME"
        )
except urllib.error.HTTPError as e:
    body = e.read(16 * 2**20 + 65536)
    try:
        result = json.loads(body)
    except (ValueError, UnicodeDecodeError):
        result = {"error": body.decode(errors="replace") or str(e)}
    if isinstance(result, dict):
        print(result.get("stdout", ""), end="")
        print(json.dumps({k: v for k, v in result.items() if k != "stdout"}, indent=2), file=sys.stderr)
    else:
        print(json.dumps(result), file=sys.stderr)
    sys.exit(1)
except (IndexError, ValueError, urllib.error.URLError) as e:
    print(str(e), file=sys.stderr)
    sys.exit(1)
